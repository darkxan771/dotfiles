    "body": "\\begin{proposition}\n $0 \n \\end{proposition}\n",
    "desc": "LaTeX Proposition Environment"
  },

  {
    "prefix": "coro",
    "body": "\\begin{corollary}\n $0 \n \\end{corollary}\n",
    "desc": "LaTeX Corollary Environment"
  },

  {
    "prefix": "rem",
    "body": "\\begin{remark}\n $0 \n \\end{remark}\n",
    "desc": "LaTeX Remark Environment"
  },

  {
    "prefix": "exam",
    "body": "\\begin{example}\n $0 \n \\end{example}\n",
    "desc": "LaTeX Example Environment"
  },

  {
    "prefix": "enum",
    "body": "\\begin{enumerate}\n\t\\item $0 \n \\end{enumerate}\n",
    "desc": "LaTeX Enumerate Environment"
  },

  {
