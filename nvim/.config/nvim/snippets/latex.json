[
  { "prefix": "skip", "body": "\\bigskip\n", "desc": "LaTeX Bigskip" },

  { "prefix": "mskip", "body": "\\medskip\n", "desc": "LaTeX Medskip" },

  {
    "prefix": "begin",
    "body": "\\begin{$1}\n $0 \n\\end{$1}\n",
    "desc": "LaTeX Begin/End Environment"
  },
  {
    "prefix": "eq",
    "body": "\\begin{equation}\n $0 \n\\end{equation}\n",
    "desc": "LaTeX Equation Environment"
  },
