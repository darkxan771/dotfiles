    "body": "\\begin{align*}\n $0 \n\\end{align*}\n",
    "desc": "LaTeX Align Environment"
  },

  {
    "prefix": "mapi",
    "body": "\\begin{align*}\n $0 &\\to  \\\\\\ \n  &\\mapsto  \n\\end{align*}\n",
    "desc": "LaTeX Map Environment"
  },

  {
    "prefix": "tikz",
    "body": "\\begin{tikzpicture}[scale=1]\n $0 \n \\end{tikzpicture}\n",
    "desc": "LaTeX TikZ Environment"
  },

  {
    "prefix": "center",
    "body": "\\begin{center}\n $0 \n \\end{center}\n",
    "desc": "LaTeX Center Environment"
  },

  {
